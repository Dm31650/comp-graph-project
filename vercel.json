{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/index.js": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/api/:route", "destination": "/api/index?route=:route" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/sign-in", "destination": "/index.html" },
    { "source": "/register", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/cart", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/cars/:id", "destination": "/index.html" }
  ]
}
